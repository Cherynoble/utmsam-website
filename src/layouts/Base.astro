---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { site } from '../data/site.js';
import '../styles/global.css';

const {
  title,
  description = site.tagline,
  progress = false,
  schema,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.longName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');

// The temporary GitHub Pages copy must not compete with the real site in
// search. Removed along with the flag when the domain moves. See astro.config.mjs.
const temporaryHost = process.env.GH_PAGES === '1';

/* One Organization record, on every page. Search engines use it for the
   knowledge panel; answer engines use it to attribute a claim about the
   society to the society. Only facts already stated on the site. */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.longName,
  alternateName: site.altNames,
  description: site.tagline,
  url: canonical.origin + base + '/',
  email: site.email,
  sameAs: [site.instagram, ...site.otherProfiles],
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Toronto Mississauga',
    url: 'https://www.utm.utoronto.ca/',
  },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {temporaryHost && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  {/* Absolute, not root-relative: every scraper resolves og:image against
      the origin, and a relative path silently yields no card. Regenerate
      with `node scripts/build-og.mjs`. */}
  <meta property="og:image" content={new URL(`${base}/og.png`, canonical)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <meta name="theme-color" content="#fffaeb" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  {progress && <ReadingProgress />}
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
