---
/**
 * The field as a surface, not as a figure. Same block unit and same six
 * ramp steps as BlockField, but noise-driven and sized to be sat on: the
 * whole grid stretches to fill its positioned parent rather than
 * cropping, so the composition reads the same at any band size.
 */
import { buildNoiseField } from '../lib/field.js';
import { PALETTE } from '../lib/pixel.js';

const { seed = 90125, w = 33, h = 14, text, animate = false, class: klass = '' } = Astro.props;
const { cells } = buildNoiseField(w, h, seed, 0.38, text);

// `animate` turns on the drift: the field never arrives, it just moves.
// Cells carry their ramp step as data-e (1 = bright yellow, 6 = ember) and
// the drift walks them a step either side of it. Integers here, where the
// homepage field ships a continuous elevation under the same name: this
// field has no descent path to walk, so a band number is all it needs.
//
// data-drift-floor is the contrast guarantee. buildNoiseField floors the
// cells under the headline at the dark end of the ramp, and without the
// flag the drift would happily brighten them back up and take the white
// type with it. The homepage field carries no type and sets no floor.
---
<svg
  class={`hero-field ${klass}`.trim()}
  data-drift={animate ? '' : undefined}
  {...(animate ? { 'data-drift-floor': '' } : {})}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  {cells.map((row, y) => row.map((ch, x) => (
    <rect
      x={x} y={y} width="1" height="1"
      fill={PALETTE[ch]}
      data-e={animate ? 8 - Number(ch) : undefined}
      vector-effect="non-scaling-stroke"
    />
  )))}
</svg>

<style>
  .hero-field { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The grid is drawn, not implied — same reason the containers carry
     their own rules. Non-scaling so the line stays 1px however far the
     cells stretch. */
  .hero-field rect { stroke: rgba(31, 31, 31, 0.14); stroke-width: 1; }

</style>

<script>
  import { startDrift } from '../lib/drift.js';
  startDrift();
</script>
