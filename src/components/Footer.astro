---
import BlockStrip from './BlockStrip.astro';
import Mark from './Mark.astro';
import { nav, site } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <BlockStrip />
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Mark />
      <p class="body site-footer__blurb">{site.longName}. A recognised student society at the University of Toronto Mississauga.</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="marker">Site</h2>
      <ul>
        {nav.map(i => <li><a href={`${base}${i.href}`} class="link">{i.label}</a></li>)}
        <li><a href={`${base}/join`} class="link">Join</a></li>
        <li><a href={`${base}/styleguide`} class="link">Style guide</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="marker">Elsewhere</h2>
      <ul>
        <li><a href={site.instagram} class="link" rel="me">Instagram</a></li>
        <li><a href={site.discord} class="link">Discord</a></li>
        <li><a href={`mailto:${site.email}`} class="link">Email</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__base">
    <p class="mono">&copy; {year} {site.name}</p>
    <p class="mono">Mississauga, Ontario</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--section-y); background: var(--cream); }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-12);
  }
  .site-footer__blurb { margin-top: var(--space-4); max-width: 42ch; }
  .site-footer ul { list-style: none; display: grid; gap: var(--space-2); margin-top: var(--space-4); }
  .site-footer__base {
    display: flex; justify-content: space-between; gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .site-footer__inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
