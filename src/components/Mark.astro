---
/**
 * The society's mark: the real logo file, not a redraw. The cube and the
 * circuit are line art, and line art at nav size is one pixel per stroke,
 * which is why the bitmap version read as static. The pixel emblem
 * survives where it works — the favicon.
 */
const { size = 48, wordmark = true, class: klass = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<span class={`mark ${klass}`}>
  <img src={`${base}/mark.png`} width={size} height={size} alt="" class="mark__glyph" />
  {wordmark && <span class="mark__word">UTMSAM</span>}
</span>

<style>
  .mark { display: inline-flex; align-items: center; gap: var(--space-3); }
  .mark__glyph { display: block; height: auto; }
  .mark__word {
    font-size: var(--text-lg);
    line-height: 1;
    letter-spacing: 0.02em;
  }
</style>
