---
import { buildField } from '../lib/field.js';
import { toRects, PALETTE } from '../lib/pixel.js';

const { w = 26, h = 15 } = Astro.props;
const { cells, path } = buildField(w, h);

// Composite the surface and the path into a single bitmap, then run-merge it
// once. Emitting one rect per cell plus a second pass for the path costs
// roughly 500 elements; merged, it is a fraction of that and the markup is
// small enough to inline without thinking about it.
const grid = cells.map(row => [...row]);
for (const [x, y] of path) grid[y][x] = '1';

// The resting point, clamped so the marker stays on the grid.
const [px, py] = path[path.length - 1];
const ex = Math.min(px, w - 2);
const ey = Math.min(py, h - 2);
for (let y = ey; y <= ey + 1; y++) {
  for (let x = ex; x <= ex + 1; x++) grid[y][x] = '1';
}

const rects = toRects(grid.map(r => r.join('')));
---
<figure class="field">
  <svg
    viewBox={`0 0 ${w} ${h}`}
    shape-rendering="crispEdges"
    role="img"
    aria-labelledby="field-caption"
    preserveAspectRatio="none"
  >
    {rects.map(r => (
      <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={PALETTE[r.ch]} />
    ))}
  </svg>
  <figcaption id="field-caption" class="mono field__caption">
    A loss surface. The dark path steps downhill to the minimum.
  </figcaption>
</figure>

<style>
  .field { display: grid; gap: var(--space-3); }
  .field svg {
    width: 100%;
    aspect-ratio: 26 / 15;
    box-shadow: var(--elev-raised);
  }
  .field__caption { color: var(--ink-muted); }
</style>
