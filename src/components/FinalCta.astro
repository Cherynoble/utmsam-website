---
import DescentMascot from './DescentMascot.astro';
import Btn from './Btn.astro';
import { site } from '../data/site.js';
const { heading = 'Come to the next one.', body = 'No application, no prerequisites, no expectation that you already know any of this.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="final">
  <div class="container final__inner">
    <div>
      <h2>{heading}</h2>
      <p class="lede final__body">{body}</p>
      <div class="final__actions">
        <Btn href={site.signupUrl}>Join UTMSAM</Btn>
        <Btn href={`${base}/events`} variant="cream">See what is running</Btn>
      </div>
    </div>
    <DescentMascot />
  </div>
</section>

<style>
  .final { border-top: 1px solid var(--border); }
  .final__inner {
    padding-block: var(--section-y);
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--space-12); flex-wrap: wrap;
  }
  .final__body { margin-top: var(--space-4); }
  /* space-between parks the mascot on the right gutter, which reads as
     abandoned at wide widths. Pull it in off the edge. */
  .final__inner :global(.descent) { margin-inline-end: clamp(0px, 8vw, 160px); }
  .final__actions { display: flex; gap: var(--space-3); margin-top: var(--space-8); flex-wrap: wrap; }
</style>
