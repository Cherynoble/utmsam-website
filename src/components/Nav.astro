---
import Mark from './Mark.astro';
import PixelIcon from './PixelIcon.astro';
import Btn from './Btn.astro';
import { nav, site } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
---
<header class="site-nav">
  <div class="container site-nav__inner">
    <a href={`${base}/`} class="site-nav__brand" aria-label={`${site.name} home`}>
      <Mark />
    </a>

    <nav aria-label="Main">
      <ul class="site-nav__list">
        {nav.map(item => (
          <li>
            <a
              href={`${base}${item.href}`}
              class="site-nav__link"
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <Btn href={site.signupUrl} class="site-nav__cta">Join UTMSAM</Btn>

    <button class="site-nav__toggle" aria-expanded="false" aria-controls="nav-drawer">
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__glyph site-nav__glyph--menu" aria-hidden="true">
        <PixelIcon name="menu" size={32} decorative />
      </span>
      <span class="site-nav__glyph site-nav__glyph--close" aria-hidden="true">
        <PixelIcon name="close" size={32} decorative />
      </span>
    </button>
  </div>

  <div class="site-nav__drawer" id="nav-drawer" hidden>
    <ul>
      {nav.map(item => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      <li><a href={site.signupUrl}>Join UTMSAM</a></li>
    </ul>
  </div>
</header>

<style>
  .site-nav {
    position: sticky; top: 0; z-index: 40;
    background: var(--warm-ivory);
    border-bottom: 1px solid var(--border);
    view-transition-name: nav;
  }
  .site-nav__inner {
    height: var(--nav-height);
    display: flex; align-items: center; gap: var(--space-8);
  }
  .site-nav__brand { margin-right: auto; }
  .site-nav__list { display: flex; gap: var(--space-6); list-style: none; }
  .site-nav__link {
    font-size: var(--text-base);
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
    transition: border-color var(--motion-fast) var(--ease-standard);
  }
  .site-nav__link:hover { border-bottom-color: var(--accent); }
  .site-nav__link[aria-current='page'] { border-bottom-color: var(--ink); }

  /* One cell, two states. Both glyphs occupy the same 44px grid area and
     the pair slides by exactly the cell height, clipped by overflow. A
     swap would blink; this reads as one control changing its mind. */
  .site-nav__toggle {
    display: none; place-content: center;
    width: 44px; height: 44px; padding: 0;
    background: none; border: 0; cursor: pointer;
    overflow: hidden; color: var(--ink);
  }
  .site-nav__glyph {
    grid-area: 1 / 1;
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .site-nav__glyph--close { transform: translateY(-44px); }
  [aria-expanded='true'] .site-nav__glyph--menu  { transform: translateY(44px); }
  [aria-expanded='true'] .site-nav__glyph--close { transform: translateY(0); }

  .site-nav__drawer { border-top: 1px solid var(--border); padding: var(--space-4) var(--gutter); }
  .site-nav__drawer ul { list-style: none; display: grid; gap: var(--space-1); }
  .site-nav__drawer a { display: block; padding: var(--space-3) 0; font-size: var(--text-lg); }

  @media (max-width: 860px) {
    .site-nav__list, .site-nav__cta { display: none; }
    .site-nav__toggle { display: grid; }
  }
  @media (min-width: 861px) {
    .site-nav__drawer { display: none; }
  }
</style>

<script>
  // Small island: the only client JS on the site.
  const toggle = document.querySelector('.site-nav__toggle');
  const drawer = document.getElementById('nav-drawer');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    drawer.hidden = open;
  });
</script>
