---
import Mark from './Mark.astro';
import { nav, site } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
---
<header class="site-nav">
  <div class="container site-nav__inner">
    <a href={`${base}/`} class="site-nav__brand" aria-label={`${site.name} home`}>
      <Mark />
    </a>

    <nav aria-label="Main">
      <ul class="site-nav__list">
        {nav.map(item => (
          <li>
            <a
              href={`${base}${item.href}`}
              class="site-nav__link"
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={`${base}/join`} class="btn btn--primary site-nav__cta">Join UTMSAM</a>

    <button class="site-nav__toggle" aria-expanded="false" aria-controls="nav-drawer">
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <div class="site-nav__drawer" id="nav-drawer" hidden>
    <ul>
      {nav.map(item => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      <li><a href={`${base}/join`}>Join UTMSAM</a></li>
    </ul>
  </div>
</header>

<style>
  .site-nav {
    position: sticky; top: 0; z-index: 40;
    background: var(--warm-ivory);
    border-bottom: 1px solid var(--border);
    view-transition-name: nav;
  }
  .site-nav__inner {
    height: var(--nav-height);
    display: flex; align-items: center; gap: var(--space-8);
  }
  .site-nav__brand { margin-right: auto; }
  .site-nav__list { display: flex; gap: var(--space-6); list-style: none; }
  .site-nav__link {
    font-size: var(--text-base);
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
    transition: border-color var(--motion-fast) var(--ease-standard);
  }
  .site-nav__link:hover { border-bottom-color: var(--accent); }
  .site-nav__link[aria-current='page'] { border-bottom-color: var(--ink); }

  .site-nav__toggle { display: none; background: none; border: 0; padding: var(--space-2); cursor: pointer; }
  .site-nav__bars { display: grid; gap: 4px; }
  .site-nav__bars i { display: block; width: 22px; height: 2px; background: var(--ink); }

  .site-nav__drawer { border-top: 1px solid var(--border); padding: var(--space-4) var(--gutter); }
  .site-nav__drawer ul { list-style: none; display: grid; gap: var(--space-1); }
  .site-nav__drawer a { display: block; padding: var(--space-3) 0; font-size: var(--text-lg); }

  @media (max-width: 860px) {
    .site-nav__list, .site-nav__cta { display: none; }
    .site-nav__toggle { display: block; }
  }
  @media (min-width: 861px) {
    .site-nav__drawer { display: none; }
  }
</style>

<script>
  // Small island: the only client JS on the site.
  const toggle = document.querySelector('.site-nav__toggle');
  const drawer = document.getElementById('nav-drawer');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    drawer.hidden = open;
  });
</script>
