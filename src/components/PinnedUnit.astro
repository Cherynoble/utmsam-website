---
import PixelIcon from './PixelIcon.astro';
const { pillar, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="unit" id={pillar.id} aria-labelledby={`${pillar.id}-h`}>
  <div class="unit__head">
    <span class="unit__chip"><PixelIcon name={pillar.icon} size={40} decorative /></span>
    <span class="mono unit__index">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <h2 id={`${pillar.id}-h`}>{pillar.heading}</h2>
  <p class="lede">{pillar.body}</p>

  <ul class="unit__bullets">
    {pillar.bullets.map(b => <li>{b}</li>)}
  </ul>

  <a href={`${base}${pillar.cta.href}`} class="link link-arrow">
    {pillar.cta.label}
    <PixelIcon name="chevron" size={16} decorative />
  </a>
</section>

<style>
  /* The rail beside these units carries the numbering and the
     navigation, so the unit itself is one column: no sticky media
     panel, no second sticky context fighting the rail. */
  .unit {
    padding-block: var(--section-y);
    border-top: 1px solid var(--border);
  }
  .unit:first-child { border-top: 0; padding-top: 0; }
  .unit > * + * { margin-top: var(--space-5); }

  /* The default 34ch measure looks stranded in a column this wide. */
  .unit .lede { max-width: 46ch; }

  .unit__head { display: flex; align-items: center; gap: var(--space-4); }
  .unit__chip {
    width: 56px; height: 56px;
    display: grid; place-items: center;
    background: var(--cream);
  }
  .unit__index { color: var(--ink-muted); }

  /* Five bullets read as a block, not as a column of leftovers. */
  .unit__bullets {
    list-style: none;
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-8);
  }
  .unit__bullets li {
    padding-left: var(--space-5);
    position: relative;
    color: var(--ink-muted);
  }
  /* The tread, reused as a list marker. */
  .unit__bullets li::before {
    content: '';
    position: absolute; left: 0; top: 0.6em;
    width: 10px; height: 4px;
    background: var(--ramp-3);
  }

  @media (max-width: 900px) {
    .unit__bullets { grid-template-columns: 1fr; }
  }
</style>
